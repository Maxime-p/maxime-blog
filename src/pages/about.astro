---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="A short introduction to the person behind Maxime-p.dev." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-5 py-16 sm:py-20">
			<section class="space-y-6" aria-labelledby="about-heading">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">About</p>
				<h1 id="about-heading" class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">A short profile is coming soon.</h1>
				<p class="max-w-2xl text-lg leading-8 text-slate-600">I’m preparing a concise introduction to the person and perspective behind this publication.</p>
				<p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">This page will be updated with factual personal information when it is ready to publish.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
