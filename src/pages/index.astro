---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestBlogPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const latestNewsItems = (await getCollection('news'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Maxime-p.dev</h1>
			<p>Original writing and curated resources for the JavaScript development ecosystem.</p>

			<section aria-labelledby="latest-blog-posts">
				<h2 id="latest-blog-posts">Latest blog posts</h2>
				<ul>
					{latestBlogPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={320} />}
								<h3>{post.data.title}</h3>
								<FormattedDate date={post.data.pubDate} />
							</a>
						</li>
					))}
				</ul>
				<p><a href="/blog">View all blog posts</a></p>
			</section>

			<section aria-labelledby="latest-news-items">
				<h2 id="latest-news-items">Latest news</h2>
				<ul>
					{latestNewsItems.map((item) => (
						<li>
							<a href={item.data.destinationUrl} target="_blank" rel="noreferrer">
								<img src={item.data.thumbnailUrl} alt="" width="320" height="160" />
								<h3>{item.data.title}</h3>
								<FormattedDate date={item.data.pubDate} />
							</a>
						</li>
					))}
				</ul>
				<p><a href="/news">View all news</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
