---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getLatestBlogPosts, getLatestNewsItems } from '../lib/publications';

const latestBlogPosts = await getLatestBlogPosts();
const latestNewsItems = await getLatestNewsItems();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
			<section class="max-w-3xl space-y-6">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Maxime-p.dev</p>
				<h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl">Original writing and useful JavaScript reading.</h1>
				<p class="max-w-2xl text-lg leading-8 text-slate-600">A personal publication for people who enjoy building on the modern web.</p>
				<div class="flex flex-wrap gap-3">
					<a class="rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/blog">Browse the blog</a>
					<a class="rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/news">Explore news</a>
					<a class="rounded-md px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/about">About Maxime</a>
				</div>
			</section>

			<section aria-labelledby="latest-blog-posts" class="mt-20">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<div><p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Original writing</p><h2 id="latest-blog-posts" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Latest blog posts</h2></div>
					<a class="text-sm font-semibold text-indigo-700 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/blog">View all posts <span aria-hidden="true">→</span></a>
				</div>
				<ul class="mt-8 grid gap-6 md:grid-cols-3">
					{latestBlogPosts.map((post) => (
						<li><a class="group block h-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" href={`/blog/${post.id}/`}>
							{post.data.heroImage && <Image class="aspect-video w-full object-cover" src={post.data.heroImage} alt="" width={480} height={270} />}
							<div class="p-5"><p class="text-sm text-slate-500"><FormattedDate date={post.data.pubDate} /></p><h3 class="mt-3 text-xl font-semibold text-slate-950 group-hover:text-indigo-700">{post.data.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{post.data.description}</p></div>
						</a></li>
					))}
				</ul>
			</section>

			<section aria-labelledby="latest-news-items" class="mt-20">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<div><p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Curated reading</p><h2 id="latest-news-items" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Latest news</h2></div>
					<a class="text-sm font-semibold text-indigo-700 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/news">View all news <span aria-hidden="true">→</span></a>
				</div>
				{
					latestNewsItems.length === 0 ? (
						<p class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">The first curated News Items are being prepared.</p>
					) : (
						<ul class="mt-8 grid gap-6 md:grid-cols-3">
							{latestNewsItems.map((item) => (
								<li><a class="group block h-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" href={item.data.destinationUrl} target="_blank" rel="noreferrer">
									<img class="aspect-video w-full object-cover" src={item.data.thumbnailUrl} alt="" width="480" height="270" />
									<div class="p-5"><h3 class="text-xl font-semibold text-slate-950 group-hover:text-indigo-700">{item.data.title}</h3><p class="mt-3 text-sm font-medium text-indigo-700">Read the source <span aria-hidden="true">↗</span></p></div>
								</a></li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
