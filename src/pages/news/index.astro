---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getNewsItems, getNewsResourceTypes } from '../../lib/publications';

const newsItems = await getNewsItems();
const newsResourceTypes = getNewsResourceTypes(newsItems);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`News | ${SITE_TITLE}`} description="Curated JavaScript development news and resources." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
			<section aria-labelledby="news-heading" class="space-y-10">
				<div class="max-w-2xl space-y-3">
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Curated reading</p>
					<h1 id="news-heading" class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">News worth opening</h1>
					<p class="text-lg leading-8 text-slate-600">A hand-picked stream of JavaScript development resources from around the web.</p>
				</div>
				{newsResourceTypes.length > 0 && (
					<div class="space-y-3">
						<h2 class="text-sm font-semibold text-slate-950">Resource type</h2>
						<nav aria-label="Filter news by resource type" class="flex flex-wrap gap-2">
							<a data-news-filter href="#" class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">All types</a>
							{newsResourceTypes.map(([resourceType]) => (
								<a data-news-filter data-filter-value={resourceType} href={`#type=${encodeURIComponent(resourceType)}`} class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">{resourceType}</a>
							))}
						</nav>
					</div>
				)}
				<p id="news-filter-status" class="sr-only" aria-live="polite"></p>
				{
					newsItems.length === 0 ? (
						<p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">The first curated News Items are being prepared.</p>
					) : (
						<ul id="news-items" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
							{newsItems.map((item) => (
								<li data-news-item data-resource-type={item.data.resourceType} class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
									<a class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" href={item.data.destinationUrl} target="_blank" rel="noreferrer">
										<img class="aspect-video w-full object-cover" src={item.data.thumbnailUrl} alt="" width="720" height="360" />
									</a>
									<div class="p-5">
										<p class="text-sm text-slate-500"><FormattedDate date={item.data.sourcePubDate} /></p>
										<a data-news-filter data-filter-value={item.data.resourceType} href={`#type=${encodeURIComponent(item.data.resourceType)}`} class="mb-3 mt-3 inline-block text-xs font-semibold uppercase tracking-wide text-slate-600 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">{item.data.resourceType}</a>
										<h2><a class="text-xl font-semibold text-slate-950 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href={item.data.destinationUrl} target="_blank" rel="noreferrer">{item.data.title}</a></h2>
										<a class="mt-3 inline-block text-sm font-medium text-indigo-700 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href={item.data.destinationUrl} target="_blank" rel="noreferrer">Read the source <span aria-hidden="true">↗</span></a>
									</div>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
		<script>
			const filterLinks = document.querySelectorAll<HTMLAnchorElement>('[data-news-filter]');
			const newsItems = document.querySelectorAll<HTMLElement>('[data-news-item]');
			const filterStatus = document.querySelector<HTMLElement>('#news-filter-status');

			function selectedResourceType() {
				const params = new URLSearchParams(window.location.hash.slice(1));
				return params.get('type');
			}

			function filterNews() {
				const resourceType = selectedResourceType();
				let visibleItems = 0;

				newsItems.forEach((item) => {
					const isVisible = !resourceType || item.dataset.resourceType === resourceType;
					item.hidden = !isVisible;
					if (isVisible) visibleItems += 1;
				});

				filterLinks.forEach((link) => {
					const value = link.dataset.filterValue;
					link.setAttribute('aria-current', value === resourceType || (!value && !resourceType) ? 'true' : 'false');
				});

				if (filterStatus) {
					filterStatus.textContent = resourceType
						? `${visibleItems} ${visibleItems === 1 ? 'News Item' : 'News Items'} matching type ${resourceType}.`
						: `Showing all ${visibleItems} News Items.`;
				}
			}

			filterLinks.forEach((link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					const value = link.dataset.filterValue;

					window.location.hash = value ? `type=${encodeURIComponent(value)}` : '';
				});
			});

			window.addEventListener('hashchange', filterNews);
			filterNews();
		</script>
	</body>
</html>
