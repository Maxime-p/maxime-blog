---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getNewsItems } from '../../lib/publications';

const newsItems = await getNewsItems();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`News | ${SITE_TITLE}`} description="Curated JavaScript development news and resources." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
			<section aria-labelledby="news-heading" class="space-y-10">
				<div class="max-w-2xl space-y-3">
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-700">Curated reading</p>
					<h1 id="news-heading" class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">News worth opening</h1>
					<p class="text-lg leading-8 text-slate-600">A hand-picked stream of JavaScript development resources from around the web.</p>
				</div>
				{
					newsItems.length === 0 ? (
						<p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">The first curated News Items are being prepared.</p>
					) : (
						<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
							{newsItems.map((item) => (
								<li>
									<a class="group block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" href={item.data.destinationUrl} target="_blank" rel="noreferrer">
										<img class="aspect-video w-full object-cover" src={item.data.thumbnailUrl} alt="" width="720" height="360" />
										<div class="p-5">
											<h2 class="text-xl font-semibold text-slate-950 group-hover:text-indigo-700">{item.data.title}</h2>
											<p class="mt-3 text-sm font-medium text-indigo-700">Read the source <span aria-hidden="true">↗</span></p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
